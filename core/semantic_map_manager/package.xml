<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>semantic_map_manager</name>
  <version>0.0.0</version>
  <description>semantic_map_manager migrated to ROS 2</description>

  <maintainer email="wdingae@todo.com">HKUST_UAV_GROUP</maintainer>
  <license>TODO</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 core -->
  <depend>rclcpp</depend>
  <depend>visualization_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Project internal deps -->
  <depend>common</depend>
  <depend>motion_predictor</depend>
  <depend>vehicle_model</depend>
  <depend>vehicle_msgs</depend>

  <!-- Third party -->
  <depend>opencv</depend>
  <depend>eigen3</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
